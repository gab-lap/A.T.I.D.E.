<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="atide_tunnel">

    <!-- Gazebo Harmonic requires these systems declared explicitly —
         unlike classic Gazebo, nothing runs without them. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Dim tunnel lighting: low ambient + a handful of point lights along
         the corridor rather than one bright directional sun. -->
    <scene>
      <ambient>0.15 0.15 0.17 1</ambient>
      <background>0.05 0.05 0.06 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="point" name="entry_light">
      <pose>1 0 2.2 0 0 0</pose>
      <diffuse>0.6 0.6 0.55 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.3</constant>
        <linear>0.2</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="mid_light">
      <pose>10 0 2.2 0 0 0</pose>
      <diffuse>0.4 0.4 0.38 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.3</constant>
        <linear>0.25</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="exit_light">
      <pose>19 0 2.2 0 0 0</pose>
      <diffuse>0.6 0.6 0.55 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.3</constant>
        <linear>0.2</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Floor: 20m corridor, 3m wide -->
    <model name="floor">
      <static>true</static>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry><box><size>20 3 0.1</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><box><size>20 3 0.1</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>10 0 -0.05 0 0 0</pose>
    </model>

    <!-- Ceiling: encloses the tunnel, reinforces the confined-space feel -->
    <model name="ceiling">
      <static>true</static>
      <link name="ceiling_link">
        <collision name="ceiling_collision">
          <geometry><box><size>20 3 0.1</size></box></geometry>
        </collision>
        <visual name="ceiling_visual">
          <geometry><box><size>20 3 0.1</size></box></geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>10 0 2.55 0 0 0</pose>
    </model>

    <!-- Left wall: three segments so the middle one can carry a distinct
         "fault zone" material without needing a separate texture map. -->
    <model name="wall_left_entry">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.1 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 2.6</size></box></geometry>
          <material><ambient>0.35 0.35 0.37 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
      </link>
      <pose>4 1.5 1.25 0 0 0</pose>
    </model>

    <model name="wall_left_faultzone">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 0.1 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 0.1 2.6</size></box></geometry>
          <material><ambient>0.5 0.2 0.15 1</ambient><diffuse>0.6 0.25 0.18 1</diffuse></material>
        </visual>
      </link>
      <pose>10 1.5 1.25 0 0 0</pose>
    </model>

    <model name="wall_left_exit">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.1 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 2.6</size></box></geometry>
          <material><ambient>0.35 0.35 0.37 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
      </link>
      <pose>16 1.5 1.25 0 0 0</pose>
    </model>

    <!-- Right wall: same three-segment split, mirrored -->
    <model name="wall_right_entry">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.1 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 2.6</size></box></geometry>
          <material><ambient>0.35 0.35 0.37 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
      </link>
      <pose>4 -1.5 1.25 0 0 0</pose>
    </model>

    <model name="wall_right_faultzone">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>4 0.1 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4 0.1 2.6</size></box></geometry>
          <material><ambient>0.5 0.2 0.15 1</ambient><diffuse>0.6 0.25 0.18 1</diffuse></material>
        </visual>
      </link>
      <pose>10 -1.5 1.25 0 0 0</pose>
    </model>

    <model name="wall_right_exit">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.1 2.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>8 0.1 2.6</size></box></geometry>
          <material><ambient>0.35 0.35 0.37 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
      </link>
      <pose>16 -1.5 1.25 0 0 0</pose>
    </model>

    <!-- Goal marker at the far end: visual only, no collision, so Nav2's
         costmap doesn't treat it as an obstacle. -->
    <model name="goal_marker">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.15 0.9 0.15 1</diffuse></material>
        </visual>
      </link>
      <pose>19 0 0.03 0 0 0</pose>
    </model>

    <!-- Spawn point marker at the near end, for reference when placing the rover -->
    <model name="spawn_marker">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.15 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
      <pose>1 0 0.03 0 0 0</pose>
    </model>

  </world>
</sdf>
